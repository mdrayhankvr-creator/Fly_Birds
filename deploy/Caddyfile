# TLS edge for one school. Caddy obtains and renews certificates
# automatically once SCHOOL_DOMAIN points at this server and ports 80/443
# are reachable from the internet.
{
	email {$ACME_EMAIL}
}

{$SCHOOL_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# The web container trusts the client address in X-Forwarded-For only on
	# this socket. Caddy trusts no upstream proxies, so it replaces any
	# X-Forwarded-For the visitor sent with the visitor's real address.
	reverse_proxy unix//run/edge/web.sock
}
