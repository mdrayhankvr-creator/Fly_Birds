# One file per school. Create it with school-provision (docs/DEPLOYMENT.md,
# section 3.2), which fills in the school's values and secrets. Keep it
# private: it is ignored by Git and must never be committed or shared
# between schools. To fill it by hand instead, generate secrets with:
#   openssl rand -base64 32     (JWT signing key)
#   openssl rand -hex 24        (database password)

# Short, unique code; it names this school's containers, volumes and network.
COMPOSE_PROJECT_NAME=greenvalley
# Include the TLS edge (Caddy). Remove when a shared reverse proxy terminates TLS.
COMPOSE_PROFILES=edge

# Public address and certificate contact.
SCHOOL_DOMAIN=school.example.edu.bd
ACME_EMAIL=it@example.edu.bd

# Database for this school only.
POSTGRES_USER=flybirds
POSTGRES_PASSWORD=
POSTGRES_DB=flybirds

# Base64 of at least 32 random bytes. Changing it invalidates current access
# tokens; sessions continue (docs/OPERATIONS.md, rotating secrets).
JWT_SIGNING_KEY_B64=

# Local port of the web container (behind the TLS edge). Give each school on
# the same host its own port.
WEB_PORT=8081

# Backups: keep this many archives; automatic interval (0 = manual only).
BACKUP_RETENTION=14
BACKUP_INTERVAL=24h

# Online payment simulation. There is no live bKash or Nagad integration.
# Keep false for every real school: true lets an administrator switch on
# simulated checkouts, which move no money. Only for disposable test schools.
PAYMENT_SIMULATION_ALLOWED=false

# Notification dispatch interval. SMS uses a MOCK provider: nothing reaches
# real phones until a real gateway is integrated.
NOTIFY_INTERVAL=1m

# Optional image tag recorded on built images, e.g. the release version.
RELEASE_TAG=v1.0.0
