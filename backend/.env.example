# Set these in your shell before running go run ./cmd/api.
PORT=8080
DATABASE_URL=postgres://flybirds:flybirds_dev@localhost:5432/flybirds?sslmode=disable

# Required whenever DATABASE_URL is set. Supply a unique random 32-byte key.
JWT_SIGNING_KEY_B64=
# Set false only for local HTTP development.
AUTH_COOKIE_SECURE=false
