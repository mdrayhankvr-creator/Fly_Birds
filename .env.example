# Local Docker Compose defaults. Copy to .env to customize.
POSTGRES_USER=flybirds
POSTGRES_PASSWORD=flybirds_dev
POSTGRES_DB=flybirds
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Generate 32 random bytes and encode as base64 before enabling auth.
JWT_SIGNING_KEY_B64=
# Local HTTP development only; use true behind HTTPS in production.
AUTH_COOKIE_SECURE=false
# Notification dispatch interval (Go duration, 0 disables). SMS use a mock
# provider only; nothing is sent to real phones.
NOTIFY_INTERVAL=1m
